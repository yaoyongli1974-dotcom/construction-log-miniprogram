/* pages/share/share.wxss - 分享页面样式 */

.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 分享卡片 */
.share-card {
  background: linear-gradient(135deg, #1AAD19 0%, #12B347 100%);
  color: #FFFFFF;
  padding: 40rpx 30rpx;
}

.share-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.share-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.share-date {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.share-project {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.share-weather {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
}

.share-content {
  background: rgba(255, 255, 255, 0.2);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.content-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  display: block;
}

.content-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  display: block;
}

.share-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

/* 按钮组 */
.btn-group {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.btn-group button {
  flex: 1;
  margin: 0;
}

/* 加载和错误状态 */
.loading-wrap,
.error-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

.error-text {
  font-size: 28rpx;
  color: var(--danger-color);
  margin-bottom: 20rpx;
}
