<!--pages/create/create.wxml - 新建日志模板 -->
<view class="container">
  <!-- 日期和天气 -->
  <view class="card">
    <view class="flex-between">
      <view class="form-item">
        <text class="label required">日期</text>
        <picker mode="date" value="{{log.date}}" bindchange="onDateChange">
          <view class="picker-value">{{log.date}}</view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="label">天气</text>
        <view class="dropdown" bindtap="toggleWeatherDropdown">
          <view class="dropdown-value">
            <text>{{log.weather || '请选择天气'}}</text>
            <text class="dropdown-arrow {{showWeatherDropdown ? 'arrow-up' : ''}}">▼</text>
          </view>
          <view class="dropdown-list" wx:if="{{showWeatherDropdown}}">
            <view 
              wx:for="{{weatherOptions}}" 
              wx:key="index"
              class="dropdown-item {{weatherIndex === index ? 'dropdown-item-active' : ''}}"
              catchtap="selectWeather"
              data-index="{{index}}"
            >{{item}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 天气下拉菜单遮罩层 -->
  <view class="dropdown-mask" wx:if="{{showWeatherDropdown}}" bindtap="closeWeatherDropdown"></view>

  <!-- 项目信息 -->
  <view class="card">
    <view class="form-item">
      <text class="label required">项目名称</text>
      <input 
        class="input-wrap {{focusField === 'projectName' ? 'input-wrap-focus' : ''}}"
        style="height: 80rpx;"
        placeholder="请输入项目名称"
        value="{{log.projectName}}"
        bindinput="onProjectNameInput"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        data-field="projectName"
      />
    </view>
    
    <view class="form-item">
      <text class="label">项目位置</text>
      <view class="location-selector" bindtap="onChooseLocation">
        <text wx:if="{{locationLoading}}" class="location-loading">获取中...</text>
        <block wx:else>
          <text wx:if="{{log.location.name}}" class="location-name">{{log.location.name}}</text>
          <text wx:else class="location-placeholder">点击选择位置</text>
          <text class="location-arrow">📍</text>
        </block>
      </view>
    </view>
  </view>
  
  <!-- 施工内容 -->
  <view class="card">
    <view class="form-item">
      <view class="label-row">
        <text class="label required">施工内容</text>
        <view class="label-btns">
          <text 
            class="voice-btn {{isVoiceRecording && voiceField === 'constructionContent' ? 'voice-btn-recording' : ''}}"
            bindtap="startVoiceInput" 
            data-field="constructionContent"
          >{{isVoiceRecording && voiceField === 'constructionContent' ? '⏹ 停止' : '🎤 语音'}}</text>
          <text class="history-btn" bindtap="showHistory" data-field="constructionContent">📋 历史</text>
        </view>
      </view>
      <textarea 
        class="input-wrap textarea textarea-large"
        id="textarea-constructionContent"
        style="height: 400rpx;"
        placeholder="请输入今日施工内容"
        value="{{log.content.constructionContent}}"
        bindinput="onConstructionContentInput"
        bindfocus="onTextareaFocus"
        bindblur="onTextareaBlur"
        bindselectionchange="onSelectionChange"
        data-field="constructionContent"
        maxlength="500"
      />
    </view>
  </view>
  
  <!-- 人员和进度 -->
  <view class="card">
    <view class="form-row">
      <view class="form-col">
        <text class="label">施工人数</text>
        <input 
          class="input-wrap input-sm"
          type="number"
          style="height: 72rpx;"
          placeholder="人数"
          value="{{log.content.personnelCount}}"
          bindinput="onPersonnelCountInput"
        />
      </view>
      <view class="form-col form-col-unit">
        <text class="label">进度</text>
        <view class="input-with-unit">
          <input 
            class="input-wrap input-sm"
            type="number"
            style="height: 72rpx;"
            placeholder="0-100"
            value="{{log.content.progressPercent}}"
            bindinput="onProgressPercentInput"
          />
          <text class="unit">%</text>
        </view>
      </view>
    </view>
    <!-- 机械台班单独一行 -->
    <view class="form-item machinery-row">
      <text class="label">机械台班</text>
      <view class="machinery-list">
        <view class="machinery-item" wx:for="{{log.content.machineryList}}" wx:key="index">
          <input 
            class="input-wrap input-xs"
            placeholder="类型"
            value="{{item.type}}"
            bindinput="onMachineryTypeInput"
            data-index="{{index}}"
          />
          <input 
            class="input-wrap input-xs input-count"
            type="digit"
            placeholder="台班"
            value="{{item.count}}"
            bindinput="onMachineryCountInput"
            data-index="{{index}}"
          />
          <text 
            class="remove-btn" 
            wx:if="{{log.content.machineryList.length > 1}}"
            bindtap="removeMachinery" 
            data-index="{{index}}"
          >✕</text>
        </view>
        <view class="add-btn" bindtap="addMachinery">+ 新增机械类型</view>
      </view>
    </view>
  </view>
  
  <!-- 质量和安全 -->
  <view class="card">
    <view class="form-item">
      <view class="label-row">
        <text class="label">质量检查</text>
        <view class="label-btns">
          <text 
            class="voice-btn {{isVoiceRecording && voiceField === 'qualityCheck' ? 'voice-btn-recording' : ''}}"
            bindtap="startVoiceInput" 
            data-field="qualityCheck"
          >{{isVoiceRecording && voiceField === 'qualityCheck' ? '⏹ 停止' : '🎤 语音'}}</text>
          <text class="history-btn" bindtap="showHistory" data-field="qualityCheck">📋 历史</text>
        </view>
      </view>
      <textarea 
        class="input-wrap textarea textarea-tall"
        id="textarea-qualityCheck"
        style="height: 280rpx;"
        placeholder="请输入质量检查情况"
        value="{{log.content.qualityCheck}}"
        bindinput="onQualityCheckInput"
        bindfocus="onTextareaFocus"
        bindblur="onTextareaBlur"
        bindselectionchange="onSelectionChange"
        data-field="qualityCheck"
        maxlength="300"
      />
    </view>
    
    <view class="form-item">
      <view class="label-row">
        <text class="label">安全检查</text>
        <view class="label-btns">
          <text 
            class="voice-btn {{isVoiceRecording && voiceField === 'safetyCheck' ? 'voice-btn-recording' : ''}}"
            bindtap="startVoiceInput" 
            data-field="safetyCheck"
          >{{isVoiceRecording && voiceField === 'safetyCheck' ? '⏹ 停止' : '🎤 语音'}}</text>
          <text class="history-btn" bindtap="showHistory" data-field="safetyCheck">📋 历史</text>
        </view>
      </view>
      <textarea 
        class="input-wrap textarea textarea-tall"
        id="textarea-safetyCheck"
        style="height: 280rpx;"
        placeholder="请输入安全检查情况"
        value="{{log.content.safetyCheck}}"
        bindinput="onSafetyCheckInput"
        bindfocus="onTextareaFocus"
        bindblur="onTextareaBlur"
        bindselectionchange="onSelectionChange"
        data-field="safetyCheck"
        maxlength="300"
      />
    </view>
  </view>
  
  <!-- 问题和计划 -->
  <view class="card">
    <view class="form-item">
      <view class="label-row">
        <text class="label">存在问题</text>
        <view class="label-btns">
          <text 
            class="voice-btn {{isVoiceRecording && voiceField === 'issues' ? 'voice-btn-recording' : ''}}"
            bindtap="startVoiceInput" 
            data-field="issues"
          >{{isVoiceRecording && voiceField === 'issues' ? '⏹ 停止' : '🎤 语音'}}</text>
          <text class="history-btn" bindtap="showHistory" data-field="issues">📋 历史</text>
        </view>
      </view>
      <textarea 
        class="input-wrap textarea textarea-tall"
        id="textarea-issues"
        style="height: 280rpx;"
        placeholder="请输入存在问题"
        value="{{log.content.issues}}"
        bindinput="onIssuesInput"
        bindfocus="onTextareaFocus"
        bindblur="onTextareaBlur"
        bindselectionchange="onSelectionChange"
        data-field="issues"
        maxlength="300"
      />
    </view>
    
    <view class="form-item">
      <view class="label-row">
        <text class="label">明日计划</text>
        <view class="label-btns">
          <text 
            class="voice-btn {{isVoiceRecording && voiceField === 'nextPlan' ? 'voice-btn-recording' : ''}}"
            bindtap="startVoiceInput" 
            data-field="nextPlan"
          >{{isVoiceRecording && voiceField === 'nextPlan' ? '⏹ 停止' : '🎤 语音'}}</text>
          <text class="history-btn" bindtap="showHistory" data-field="nextPlan">📋 历史</text>
        </view>
      </view>
      <textarea 
        class="input-wrap textarea textarea-tall"
        id="textarea-nextPlan"
        style="height: 280rpx;"
        placeholder="请输入明日计划"
        value="{{log.content.nextPlan}}"
        bindinput="onNextPlanInput"
        bindfocus="onTextareaFocus"
        bindblur="onTextareaBlur"
        bindselectionchange="onSelectionChange"
        data-field="nextPlan"
        maxlength="300"
      />
    </view>
  </view>
  
  <!-- 现场照片 -->
  <view class="card">
    <view class="form-item">
      <text class="label">现场照片</text>
      <view class="images-wrap">
        <view class="image-item" wx:for="{{log.images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" class="preview-image"></image>
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
        </view>
        
        <view class="add-image" bindtap="chooseImages" wx:if="{{log.images.length < 9}}">
          <text class="add-icon">+</text>
          <text class="add-text">添加照片</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 操作按钮 -->
  <view class="btn-group">
    <button class="btn-secondary" bindtap="saveAsDraft" disabled="{{saving}}">保存草稿</button>
    <button class="btn-primary" bindtap="publishLog" disabled="{{saving}}">发布日志</button>
  </view>
</view>

<!-- 历史记录面板（遮罩层 + 居中弹出） -->
<view class="history-mask" wx:if="{{showHistory}}" bindtap="closeHistory"></view>
<view class="history-panel-modal" wx:if="{{showHistory}}">
  <view class="history-header">
    <text class="history-title">历史记录 - {{historyFieldName}}</text>
    <text class="history-close" bindtap="closeHistory">✕</text>
  </view>
  <scroll-view class="history-list" scroll-y="true" wx:if="{{historyList.length > 0}}">
    <view class="history-item" wx:for="{{historyList}}" wx:key="index" bindtap="selectHistory" data-value="{{item}}">
      <text class="history-text">{{item}}</text>
      <text class="history-delete" catchtap="deleteHistory" data-index="{{index}}">删除</text>
    </view>
  </scroll-view>
  <view class="history-empty" wx:else>
    <text>暂无历史记录</text>
  </view>
</view>
