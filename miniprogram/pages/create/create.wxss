/* pages/create/create.wxss - 新建日志样式 */

.container {
  padding: 20rpx;
  padding-bottom: 200rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

/* label 和按钮在同一行 */
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-row .label {
  margin-bottom: 0;
}

/* 历史记录按钮 */
.history-btn {
  font-size: 24rpx;
  color: var(--primary-color, #07C160);
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--primary-color, #07C160);
  border-radius: 8rpx;
  flex-shrink: 0;
}

.history-btn:active {
  background: rgba(7, 193, 96, 0.1);
}

/* 内联表单项（label 和输入框在同一行） */
.form-item-inline {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-item-inline .label {
  width: 160rpx;
  flex-shrink: 0;
  margin-bottom: 0;
}

.input-with-unit {
  display: flex;
  align-items: center;
  flex: 1;
}

.input-with-unit .input-wrap {
  flex: 1;
}

.input-with-unit .unit {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* 日期和天气 */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.form-item {
  flex: 1;
}

.picker-value {
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: #FFFFFF;
  min-height: 40rpx;
  display: flex;
  align-items: center;
}

.weather-value {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 16rpx 0;
}

/* 位置选择器 */
.location-selector {
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 40rpx;
}

.location-selector:active {
  background: #F5F5F5;
}

.location-loading {
  color: var(--text-hint);
  font-size: 28rpx;
}

.location-name {
  color: var(--text-primary);
  font-size: 28rpx;
  flex: 1;
  margin-right: 10rpx;
}

.location-placeholder {
  color: var(--text-hint);
  font-size: 28rpx;
  flex: 1;
  margin-right: 10rpx;
}

.location-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

/* 输入框 */
.input-wrap {
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

/* 多行输入框统一高度 */
.textarea {
  min-height: 300rpx;
  width: 100%;
  line-height: 1.6;
}

/* 质量/安全/问题/计划 输入框更高，方便多行输入 */
.textarea-tall {
  min-height: 260rpx;
}

/* 施工内容输入框最高，内容通常最多 */
.textarea-large {
  min-height: 400rpx;
}

.unit {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* 图片上传 */
.images-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 0 0 0 8rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #FAFAFA;
}

.add-icon {
  font-size: 48rpx;
  color: var(--text-hint);
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 按钮组 */
.btn-group {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-group button {
  flex: 1;
  margin: 0;
}

/* 历史记录面板 - 遮罩层 */
.history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

/* 历史记录面板 - 居中弹出 */
.history-panel-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 680rpx;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.history-close {
  font-size: 40rpx;
  color: var(--text-hint);
  padding: 10rpx;
}

.history-list {
  max-height: 50vh;
  overflow-y: auto;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 2rpx solid #F5F5F5;
  transition: background 0.2s;
}

.history-item:active {
  background: #F5F5F5;
}

.history-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-delete {
  font-size: 24rpx;
  color: #FF4D4F;
  padding: 8rpx 16rpx;
  border: 2rpx solid #FF4D4F;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.history-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: var(--text-hint);
}
