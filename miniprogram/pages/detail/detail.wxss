/* pages/detail/detail.wxss - 日志详情样式 */

.container {
  padding: 20rpx;
  padding-bottom: 200rpx;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #1AAD19 0%, #12B347 100%);
  color: #FFFFFF;
}

.header-card .log-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.header-card .log-status {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

.header-card .log-project {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin: 16rpx 0;
}

.header-card .log-weather {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 章节标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.section-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.section-content:last-child {
  margin-bottom: 0;
}

/* 子标题 */
.sub-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.sub-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

/* 信息网格 */
.info-grid {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.info-item {
  flex: 1;
  background: var(--bg-color);
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
  display: block;
}

/* 机械台班单独一行 */
.info-machinery {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
}

.info-machinery .info-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 0;
  flex-shrink: 0;
}

.info-machinery .info-value {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-color);
  display: block;
}

/* 图片网格 */
.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-group button {
  flex: 1;
  margin: 0;
}

.btn-danger {
  background: var(--danger-color);
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-danger::after {
  border: none;
}

.share-btn {
  margin-top: 20rpx;
  width: 100%;
}

/* 加载和错误状态 */
.loading-wrap,
.error-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

.error-text {
  font-size: 28rpx;
  color: var(--danger-color);
  margin-bottom: 20rpx;
}
