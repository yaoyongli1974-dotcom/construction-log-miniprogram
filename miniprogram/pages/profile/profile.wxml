<!--pages/profile/profile.wxml - 个人中心模板（静默登录版）-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="card user-card">
    <view class="user-info flex-row">
      <!-- 头像：使用新API button open-type="chooseAvatar" -->
      <button 
        class="avatar-btn" 
        open-type="chooseAvatar" 
        bindchooseavatar="onChooseAvatar"
      >
        <image 
          class="user-avatar" 
          src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" 
          mode="aspectFill"
        ></image>
      </button>
      <view class="user-details">
        <!-- 昵称：使用新API input type="nickname" -->
        <input 
          class="nickname-input" 
          type="nickname" 
          value="{{userInfo.nickName || '微信用户'}}"
          placeholder="点击设置昵称"
          bindchange="onInputNickname"
        />
        <text class="user-id">ID: {{openid || '加载中...'}}</text>
      </view>
    </view>
  </view>
  
  <!-- 统计数据 -->
  <view class="card stats-card">
    <view class="stats-grid">
      <view class="stat-item" bindtap="viewAllLogs">
        <text class="stat-number">{{stats.totalLogs}}</text>
        <text class="stat-label">总日志数</text>
      </view>
      <view class="stat-item" bindtap="viewAllLogs">
        <text class="stat-number">{{stats.thisMonthLogs}}</text>
        <text class="stat-label">本月日志</text>
      </view>
      <view class="stat-item" bindtap="viewDrafts">
        <text class="stat-number">{{stats.draftCount}}</text>
        <text class="stat-label">草稿箱</text>
      </view>
    </view>
  </view>
  
  <!-- 功能列表 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="onShareAppMessage">
      <text class="menu-icon">📤</text>
      <text class="menu-text">分享给好友</text>
      <text class="menu-arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
  
  <!-- 关于 -->
  <view class="card about-card">
    <view class="about-item">
      <text class="about-label">版本号</text>
      <text class="about-value">v1.0.0</text>
    </view>
    <view class="about-item">
      <text class="about-label">关于我们</text>
      <text class="about-value">施工日志小程序团队</text>
    </view>
  </view>
  
  <!-- 分享按钮 -->
  <button class="btn-primary share-btn" open-type="share">分享小程序</button>
</view>
