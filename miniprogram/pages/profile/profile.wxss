/* pages/profile/profile.wxss - 个人中心样式 */

.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #07C160 0%, #12B347 100%);
  color: #FFFFFF;
  padding: 40rpx 30rpx;
  border-radius: 16rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

/* 头像按钮（包裹 image，使用新API） */
.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  min-height: auto;
  width: 120rpx;
  height: 120rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-details {
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* 昵称输入框（使用新API input type="nickname"） */
.nickname-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  background: transparent;
  border: none;
  padding: 0;
  width: 100%;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计数据卡片 */
.stats-card {
  margin-top: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 功能菜单 */
.menu-card {
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 50rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 关于卡片 */
.about-card {
  margin-top: 20rpx;
}

.about-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.about-item:last-child {
  border-bottom: none;
}

.about-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.about-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 分享按钮 */
.share-btn {
  margin-top: 40rpx;
  width: 100%;
}
