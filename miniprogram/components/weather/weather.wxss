/* components/weather/weather.wxss - 天气组件样式 */

.weather-wrap {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--card-bg);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.weather-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.weather-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.weather-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.weather-loading {
  display: flex;
  align-items: center;
  flex: 1;
}

.loading-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

.refresh-btn {
  padding: 8rpx;
  margin-left: 16rpx;
}

.refresh-icon {
  font-size: 32rpx;
}
