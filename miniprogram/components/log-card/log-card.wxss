/* components/log-card/log-card.wxss - 日志卡片组件样式 */

.log-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.log-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.log-date {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.log-weather {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.log-project {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-bottom: 16rpx;
}

.log-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  display: flex;
  align-items: center;
}

.summary-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.summary-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.log-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border-color);
}

.log-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.badge-success {
  background: #E8F5E9;
  color: #4CAF50;
}

.badge-warning {
  background: #FFF3E0;
  color: #FF9800;
}

.log-images {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 图片预览 */
.images-preview {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  position: relative;
}

.preview-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.more-images {
  position: absolute;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
