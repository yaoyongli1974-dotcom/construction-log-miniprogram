<!--components/loading/loading.wxml - 加载动画组件 -->
<view class="loading-container" wx:if="{{show}}">
  <view class="loading-content {{animating ? 'fade-in' : 'fade-out'}}">
    <!-- 圆形加载动画 -->
    <view class="loading-circle" wx:if="{{type === 'circle'}}">
      <view class="circle-spinner">
        <view class="circle-dot" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this"
              style="transform: rotate({{item * 45}}deg); animation-delay: {{-1.1 + item * 0.1}}s;">
        </view>
      </view>
    </view>

    <!-- 点状加载动画 -->
    <view class="loading-dots" wx:elif="{{type === 'dots'}}">
      <view class="dot" wx:for="{{[1,2,3]}}" wx:key="*this"
            style="animation-delay: {{item * 0.15}}s;">
      </view>
    </view>

    <!-- 脉冲加载动画 -->
    <view class="loading-pulse" wx:elif="{{type === 'pulse'}}">
      <view class="pulse-ring"></view>
      <view class="pulse-ring" style="animation-delay: 0.5s;"></view>
    </view>

    <!-- 加载提示文字 -->
    <text class="loading-text">{{text}}</text>
  </view>
</view>
